{
  "tier": "T3",
  "actors": {
    "attacker": { "disposition": 1, "pos": [100, 100] },
    "defender": { "hp": 100, "ac": 1, "disposition": -1, "pos": [200, 100] }
  },
  "steps": [
    { "cast": "attacker", "ability": "main", "targets": ["defender"] },
    { "snapshot": "main" },
    { "advanceUntil": { "round": 2, "actor": "attacker" }, "onlyScenarios": ["rechargeOk", "rechargeFail"] },
    { "snapshot": "afterTurn", "onlyScenarios": ["rechargeOk", "rechargeFail"] }
  ],
  "scenarios": [
    { "name": "fail",    "forces": { "defender": { "save": "fail" } },    "assert": [{ "at": "main", "actor": "defender", "hpDelta": -12 }] },
    { "name": "success", "forces": { "defender": { "save": "success" } }, "assert": [{ "at": "main", "actor": "defender", "hpDelta": -6 }] },
    { "name": "rechargeOk", "forces": { "defender": { "save": "fail" }, "attacker": { "recharge": "success" } }, "assert": [
      { "at": "main",      "actor": "attacker", "usesSpent": 1 },
      { "at": "afterTurn", "actor": "attacker", "usesSpent": 0 }
    ] },
    { "name": "rechargeFail", "forces": { "defender": { "save": "fail" }, "attacker": { "recharge": "fail" } }, "assert": [
      { "at": "main",      "actor": "attacker", "usesSpent": 1 },
      { "at": "afterTurn", "actor": "attacker", "usesSpent": 1 }
    ] }
  ]
}
