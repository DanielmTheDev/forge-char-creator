{
  "tier": "T3",
  "actors": {
    "attacker": { "disposition": 1, "pos": [100, 100] },
    "defender": { "hp": 100, "ac": 15, "disposition": -1, "pos": [200, 100] }
  },
  "steps": [
    { "cast": "attacker", "ability": "main", "targets": ["defender"] },
    { "snapshot": "main" }
  ],
  "scenarios": [
    { "name": "hit", "forces": { "defender": { "attack": "hit" } }, "assert": [
      { "at": "main", "actor": "defender", "hpDelta": -10 },
      { "at": "main", "actor": "attacker", "lastWorkflow.hit": true }
    ] },
    { "name": "miss", "forces": { "defender": { "attack": "miss" } }, "assert": [
      { "at": "main", "actor": "defender", "hpDelta": 0 },
      { "at": "main", "actor": "attacker", "lastWorkflow.hit": false }
    ] },
    { "name": "adv", "forces": { "defender": { "attack": "hit" }, "attacker": { "advantage": true } }, "assert": [
      { "at": "main", "actor": "defender", "hpDelta": -10 },
      { "at": "main", "actor": "attacker", "lastWorkflow.hit": true, "lastWorkflow.advantage": true, "lastWorkflow.disadvantage": false }
    ] },
    { "name": "dis", "forces": { "defender": { "attack": "hit" }, "attacker": { "disadvantage": true } }, "assert": [
      { "at": "main", "actor": "defender", "hpDelta": -10 },
      { "at": "main", "actor": "attacker", "lastWorkflow.hit": true, "lastWorkflow.disadvantage": true, "lastWorkflow.advantage": false }
    ] },
    { "name": "grantAdv", "forces": { "defender": { "attack": "hit", "grantAdvantage": true } }, "assert": [
      { "at": "main", "actor": "defender", "hpDelta": -10 },
      { "at": "main", "actor": "attacker", "lastWorkflow.hit": true, "lastWorkflow.advantage": true, "lastWorkflow.disadvantage": false }
    ] },
    { "name": "grantDis", "forces": { "defender": { "attack": "hit", "grantDisadvantage": true } }, "assert": [
      { "at": "main", "actor": "defender", "hpDelta": -10 },
      { "at": "main", "actor": "attacker", "lastWorkflow.hit": true, "lastWorkflow.disadvantage": true, "lastWorkflow.advantage": false }
    ] }
  ]
}
