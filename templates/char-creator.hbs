<form class="forge-char-creator-content standard-form flexcol">
  <div class="fc-layout">
  <nav class="fc-steps-nav" aria-label="Steps"></nav>
  <div class="forge-form-body scrollable fc-panes">
  <section class="fc-step" data-step="identity" data-title="Identity">
  <p class="hint">{{message}}</p>
      <div class="fc-form">
        <label for="charName">Name</label>
        <input type="text" id="charName" name="charName" placeholder="Enter name...">

        <label for="actorFolder">Folder</label>
        <select id="actorFolder" name="actorFolder" data-tooltip="Actor folder the new actor goes into.">
          {{#each folders as |f|}}
          <option value="{{f.id}}" {{#if f.selected}}selected{{/if}}>{{f.label}}</option>
          {{/each}}
        </select>

        <label for="portraitUpload">Portrait</label>
        <div class="fc-ctl fc-nowrap">
          <input type="file" id="portraitUpload" data-tooltip="Image for the portrait. A round token with a ring is generated from it." name="portraitUpload" accept="image/*">
          <img id="portraitPreview" class="fc-portrait" src="icons/svg/mystery-man.svg" alt="Preview" width="48" height="48">
        </div>
      </div>

      <div class="fc-cols">
        <fieldset>
          <legend>Actor Size</legend>
          <div class="fc-radios">
            <label><input type="radio" name="size" value="tiny"> Tiny</label>
            <label><input type="radio" name="size" value="sm"> Small</label>
            <label><input type="radio" name="size" value="med" checked> Medium</label>
            <label><input type="radio" name="size" value="lg"> Large</label>
            <label><input type="radio" name="size" value="huge"> Huge</label>
            <label><input type="radio" name="size" value="grg"> Gargantuan</label>
          </div>
        </fieldset>

        <fieldset>
          <legend data-tooltip="Token border color and who the creature is hostile to.">Token Disposition</legend>
          <div class="fc-radios">
            <label><input type="radio" name="disposition" value="1"> Friendly</label>
            <label><input type="radio" name="disposition" value="0"> Neutral</label>
            <label><input type="radio" name="disposition" value="-1" checked> Hostile</label>
          </div>
        </fieldset>
      </div>

  </section>

  <section class="fc-step" data-step="stats" data-title="Stats">
      <fieldset>
        <legend data-tooltip="Pick a level and archetype to fill AC, HP, abilities and spellcasting below. Edit freely afterwards.">Template</legend>
        <div class="fc-pairs">
          <label for="charLevel">Level / CR</label>
          <select id="charLevel" name="charLevel" data-tooltip="Level (PCs) or challenge rating (monsters). Used by the archetype template.">
            {{#each (range 1 20) as |lvl|}}
            <option value="{{lvl}}">{{lvl}}</option>
            {{/each}}
          </select>
          <label for="charArchetype">Archetype</label>
          <select id="charArchetype" name="charArchetype" data-tooltip="Fills AC, HP and ability scores with sensible values for the level. Edit freely afterwards.">
            <option value="custom">-- Custom / blank --</option>
            <option value="warrior">Heavy Warrior / Tank</option>
            <option value="rogue">Agile Rogue / Skirmisher</option>
            <option value="mage_int">Intelligence Mage</option>
            <option value="cleric_wis">Wisdom Cleric / Druid</option>
            <option value="mage_cha">Charisma Caster (Bard/Sorcerer)</option>
          </select>
        </div>
      </fieldset>

      <fieldset class="combat-stats-fieldset">
        <legend>Combat Attributes</legend>
        <div class="fc-pairs">
          <label for="ac">Armor Class</label>
          <input type="number" id="ac" name="ac" data-tooltip="Flat armor class." value="10" step="1" required>
          <label for="hp">Health (HP)</label>
          <input type="number" id="hp" name="hp" data-tooltip="Maximum (and starting) hit points." value="10" step="1" required>
        </div>
      </fieldset>

      <fieldset class="abilities-fieldset">
        <legend>Ability Scores</legend>
        <div class="fc-abilities">
          {{#each abilities as |label key|}}
          <div class="fc-stat">
            <label for="ability-{{key}}">{{label}}</label>
            <input type="number" id="ability-{{key}}" name="abilities.{{key}}" value="10" step="1" required>
          </div>
          {{/each}}
        </div>
      </fieldset>

      <fieldset class="spellcasting-fieldset">
        <legend>Spellcasting</legend>
        <div class="fc-pairs">
          <label for="spellcasting">Ability</label>
          <select id="spellcasting" name="spellcasting" data-tooltip="Ability used for spell attacks and save DCs. None for non-casters.">
            <option value="">None</option>
            <option value="int">Intelligence</option>
            <option value="wis">Wisdom</option>
            <option value="cha">Charisma</option>
            <option value="str">Strength</option>
            <option value="dex">Dexterity</option>
            <option value="con">Constitution</option>
          </select>
          <label for="spellLevel">Level</label>
          <input type="number" id="spellLevel" name="spellLevel" data-tooltip="Caster level: sets spell slots and cantrip scaling." value="0" min="0" step="1">
        </div>
      </fieldset>

  </section>

  <section class="fc-step" data-step="features" data-title="Features">
      <fieldset class="compendium-search-fieldset" style="margin-bottom: 10px; position: relative;">
        <legend>Compendium Items</legend>
        <div class="form-group flexcol" style="margin: 0;">
          <p class="notes" style="margin-bottom: 5px;">Search all compendiums for spells, weapons, and features to grant this NPC.</p>
          <div class="search-container flexrow" style="position: relative; width: 100%; gap: 6px; align-items: center;">
            <input type="text" id="itemSearchQuery" placeholder="Search items..." data-tooltip="Type to search every compendium. ↑/↓ to move, Enter to add, Esc to close." style="flex: 1; height: 2rem; padding: 0 0.5rem; border-radius: 4px; border: 1px solid var(--color-border-light-primary);">
            <button type="button" data-action="createNewFeature" data-tooltip="Build a new attack or ability for this creature." style="width: auto; padding: 0 8px; height: 2rem; white-space: nowrap;"><i class="fas fa-plus"></i> Create New</button>
            <ul id="itemSearchResults" class="search-results-dropdown" style="display: none; top: 100%; left: 0; width: 100%;"></ul>
          </div>
        </div>
        <div class="form-group flexcol" style="margin-top: 10px;">
          <label>Selected Items:</label>
          <div id="selectedItemsBin" class="selected-items-bin">
            <span class="empty-bin-msg" style="color: var(--color-text-light-5); font-style: italic; font-size: 0.9em;">No items selected.</span>
          </div>
        </div>
      </fieldset>

  </section>

  <section class="fc-step" data-step="token" data-title="Token">
      <fieldset class="aura-fieldset" style="margin-top: 10px; position: relative;">
        <legend style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="enableAura" name="enableAura" data-tooltip="Draw a colored ring around the token (Token Aura Ring module)." style="margin: 0;"> Token Aura Ring
        </legend>
        <div id="auraOptions" style="display: none; flex-direction: column; gap: 10px; margin-top: 5px;">
          <div class="flexrow" style="gap: 10px;">
            <div class="form-group flexcol" style="margin: 0; flex: 1;">
              <label for="auraRadius">Radius (ft)</label>
              <div class="form-fields">
                <input type="number" id="auraRadius" name="auraRadius" value="20" min="0" step="5">
              </div>
            </div>
            <div class="form-group flexcol" style="margin: 0; flex: 1;">
              <label for="auraColor">Ring Color</label>
              <div class="form-fields" style="display: flex; gap: 5px; align-items: center;">
                <input type="color" id="auraColor" name="auraColor" value="#ff0000" style="width: 30px; height: 30px; padding: 0;">
                <input type="text" id="auraColorText" name="auraColorText" value="#ff0000" style="flex: 1;" oninput="document.getElementById('auraColor').value = this.value">
              </div>
            </div>
          </div>
          <div class="flexrow" style="gap: 10px;">
            <div class="form-group flexcol" style="margin: 0; flex: 1;">
              <label for="auraVisibility">Visible To</label>
              <div class="form-fields">
                <select id="auraVisibility" name="auraVisibility">
                  <option value="PLAYER">Players & GM</option>
                  <option value="GAMEMASTER">GM Only</option>
                </select>
              </div>
            </div>
            <div class="form-group flexcol" style="margin: 0; flex: 1;">
              <label for="auraGrid">Grid-based Shape?</label>
              <div class="form-fields" style="display: flex; align-items: center; height: 100%;">
                <input type="checkbox" id="auraGrid" name="auraGrid" style="margin: 0;">
              </div>
            </div>
          </div>
        </div>
      </fieldset>

      <fieldset class="link-actor-fieldset" style="margin-top: 10px;">
        <legend>Actor Data</legend>
        <label style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="linkActorData" name="linkActorData" data-tooltip="Linked: every token IS this actor (unique NPCs). Unlinked: each token is an independent copy (mooks)." style="margin: 0;">
          Link Actor Data
        </label>
        <p class="hint" style="margin: 4px 0 0;">
          Tokens share this actor's data (HP, effects). Leave off for mooks that need independent copies.
        </p>
      </fieldset>
  </section>
  </div>
  </div>

  <footer class="form-footer">
    <span class="fc-keys"></span>
    <button type="button" class="create-btn" data-action="createNPC">
      <i class="fas fa-hammer"></i> Create
    </button>
  </footer>
</form>