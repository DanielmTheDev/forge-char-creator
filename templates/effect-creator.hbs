<form class="forge-effect-creator-content standard-form flexcol">
  <div class="fc-layout">
    <nav class="fc-steps-nav" aria-label="Steps"></nav>
    <div class="forge-form-body scrollable fc-panes">

    <!-- ── Step: Basics ──────────────────────────────────────────────────── -->
    <section class="fc-step" data-step="basics" data-title="Basics">
      <fieldset>
        <legend>What is it?</legend>
        <div class="fc-kinds">
          {{#each kinds as |k|}}
          <label class="fc-kind" data-tooltip="{{k.hint}}">
            <input type="radio" name="kind" data-ef="kind" value="{{k.id}}"
                   {{#if (eq ../s.kind k.id)}}checked{{/if}}
                   {{#if ../s.isLocked}}{{#if (eq k.id "effect")}}disabled{{/if}}{{/if}}>
            <span>{{k.label}}</span>
          </label>
          {{/each}}
        </div>
      </fieldset>

      <fieldset>
        <legend>Identity</legend>
        <div class="flexrow" style="gap:8px; align-items:center; margin-bottom:6px;">
          <input type="text" data-ef="name" placeholder="Name" value="{{s.name}}" style="flex:1; height:2rem;"
                 data-tooltip="Shown on the sheet and in chat.">
          <button type="button" class="fc-icon-btn" data-action="pickIcon" data-tooltip="Choose an icon (searchable)">
            <img id="efImgPreview" src="{{s.img}}" alt="Icon" width="36" height="36">
          </button>
          <input type="text" data-ef="img" value="{{s.img}}" style="flex:1; height:2rem; font-size:0.8em;"
                 data-tooltip="Icon file path. Use the icon button to search instead of typing.">
        </div>
        <textarea data-ef="description" placeholder="Description — leave blank to auto-generate from your choices"
                  style="width:100%; height:3.5rem; resize:vertical; font-size:0.9em;">{{s.description}}</textarea>
      </fieldset>

      <fieldset id="deliveryBasics">
        <legend>Use</legend>
        <div class="fc-row">
          <label data-tooltip="What it costs to use in combat.">Activation
            <select data-ef="wrapActivation">
              {{#each activationTypes as |at|}}
              <option value="{{at.id}}" {{#if (eq ../s.wrapActivation at.id)}}selected{{/if}}>{{at.label}}</option>
              {{/each}}
            </select>
          </label>
          <label data-tooltip="At will = unlimited. X / long rest = limited uses. Recharge = roll a d6 each turn; regains its use on N–6.">Uses
            <select data-ef="usesMode">
              <option value="atwill" {{#if (eq s.usesMode "atwill")}}selected{{/if}}>At will</option>
              <option value="perRest" {{#if (eq s.usesMode "perRest")}}selected{{/if}}>X / long rest</option>
              <option value="recharge" {{#if (eq s.usesMode "recharge")}}selected{{/if}}>Recharge</option>
            </select>
          </label>
          <label id="usesMaxBox" data-tooltip="Uses per long rest.">Uses
            <input type="number" data-ef="usesMax" value="{{s.usesMax}}" min="1" class="fc-num">
          </label>
          <label id="rechargeBox" data-tooltip="Recharges when the d6 shows this number or higher.">Recharge on
            <select data-ef="rechargeOn">
              {{#each rechargeOpts as |r|}}
              <option value="{{r}}" {{#if (eq ../s.rechargeOn r)}}selected{{/if}}>{{r}}–6</option>
              {{/each}}
            </select>
          </label>
        </div>
        <div class="fc-row" id="targetRow">
          <div id="wrapTargetCountBox" style="display:flex; align-items:center; gap:6px;" data-tooltip="How many creatures it can target.">
            <span style="font-size:0.9em; font-weight:bold; white-space:nowrap;">Targets:</span>
            <input type="number" data-ef="wrapTargetCount" value="{{s.wrapTargetCount}}" min="1" class="fc-num">
          </div>
          <div id="wrapAreaSizeBox" style="display:none; align-items:center; gap:6px;" data-tooltip="Size of the area in feet (radius, cone length, cube side…).">
            <span style="font-size:0.9em; font-weight:bold; white-space:nowrap;">Size (ft):</span>
            <input type="number" data-ef="wrapAreaSize" value="{{s.wrapAreaSize}}" min="0" step="5" class="fc-num">
          </div>
          <div style="display:flex; align-items:center; gap:6px; flex:1;" data-tooltip="Who or what it targets. Area types (radius, cone…) place a template.">
            <span style="font-size:0.9em; font-weight:bold; white-space:nowrap;">Target type:</span>
            <select data-ef="wrapTargetArea" style="height:1.8rem; flex:1;">
              {{#each targetTypes as |label id|}}
              <option value="{{id}}" {{#if (eq ../s.wrapTargetArea id)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="fc-row" id="buffRow">
          <label data-tooltip="Apply the effect from the Effects step."><input type="radio" name="buffMode" data-ef="buffMode" value="apply" {{#if (eq s.buffMode "apply")}}checked{{/if}}> Apply effect</label>
          <label data-tooltip="Grant temporary hit points (a real dnd5e heal)."><input type="radio" name="buffMode" data-ef="buffMode" value="temphp" {{#if (eq s.buffMode "temphp")}}checked{{/if}}> Temp HP</label>
          <label id="tempHpBox" data-tooltip="Dice or flat number, e.g. 2d4+2. Temp HP doesn't stack: the higher value wins.">Temp HP
            <input type="text" data-ef="tempHpFormula" value="{{s.tempHpFormula}}" placeholder="2d4+2" class="fc-formula">
          </label>
        </div>
      </fieldset>
    </section>

    <!-- ── Step: Attack ──────────────────────────────────────────────────── -->
    <section class="fc-step" data-step="attack" data-title="Attack">
      <fieldset>
        <legend>Attack roll</legend>
        <div class="fc-row">
          <label data-tooltip="Melee uses reach, ranged uses range.">Type
            <select data-ef="attackType">
              <option value="melee" {{#if (eq s.attackType "melee")}}selected{{/if}}>Melee</option>
              <option value="ranged" {{#if (eq s.attackType "ranged")}}selected{{/if}}>Ranged</option>
            </select>
          </label>
          <label data-tooltip="Reach or range in feet.">Reach / range (ft)
            <input type="number" data-ef="attackRange" value="{{s.attackRange}}" min="0" step="5" class="fc-num">
          </label>
        </div>
        <div class="fc-row">
          <label data-tooltip="Fixed: exactly the number on the statblock (e.g. +7 to hit). Doesn't change with stats.">
            <input type="radio" name="toHitMode" data-ef="toHitMode" value="flat" {{#if (eq s.toHitMode "flat")}}checked{{/if}}> Fixed bonus
          </label>
          <label data-tooltip="Calculated: ability modifier + proficiency + extra bonus. Scales when the creature's stats change.">
            <input type="radio" name="toHitMode" data-ef="toHitMode" value="derived" {{#if (eq s.toHitMode "derived")}}checked{{/if}}> Calculated
          </label>
          <label id="toHitFlatBox" data-tooltip="Total attack bonus, e.g. 7 for '+7 to hit'.">To hit +
            <input type="text" data-ef="toHitFlat" value="{{s.toHitFlat}}" class="fc-num" placeholder="7">
          </label>
          <span id="toHitDerivedBox" class="fc-row" style="margin:0;">
            <select data-ef="toHitAbility" data-tooltip="Ability whose modifier is added.">
              {{#each abilities as |ab|}}
              <option value="{{ab.[0]}}" {{#if (eq ../s.toHitAbility ab.[0])}}selected{{/if}}>{{ab.[1]}}</option>
              {{/each}}
            </select>
            + prof +
            <input type="text" data-ef="toHitBonus" value="{{s.toHitBonus}}" class="fc-num" placeholder="0"
                   data-tooltip="Extra bonus on top, e.g. 1 for a +1 weapon.">
          </span>
        </div>
      </fieldset>
      <fieldset>
        <legend data-tooltip="Damage dealt on a hit. One row per damage type (e.g. 1d8+3 piercing + 2d6 poison).">Damage on hit</legend>
        <div id="damageRows"></div>
        <button type="button" data-add-row="damageRows"><i class="fas fa-plus"></i> Add damage</button>
      </fieldset>
      <label class="fc-row" data-tooltip="On a hit, the target also rolls a saving throw (e.g. 'DC 13 CON or be poisoned'). Set it up in the next step.">
        <input type="checkbox" data-ef="onHitSave" {{#if s.onHitSave}}checked{{/if}}> On hit: target makes a saving throw
      </label>
    </section>

    <!-- ── Step: Saving Throw ────────────────────────────────────────────── -->
    <section class="fc-step" data-step="save" data-title="Saving Throw">
      <fieldset>
        <legend>Saving throw</legend>
        <div class="fc-row" id="saveModeRow">
          <label data-tooltip="Targets roll a save."><input type="radio" name="saveMode" data-ef="saveMode" value="save" {{#if (eq s.saveMode "save")}}checked{{/if}}> Save</label>
          <label data-tooltip="No roll at all: damage and effects just happen."><input type="radio" name="saveMode" data-ef="saveMode" value="none" {{#if (eq s.saveMode "none")}}checked{{/if}}> No save (auto damage)</label>
        </div>
        <div class="fc-row" id="saveParams">
          <label data-tooltip="Which saving throw the target rolls.">Ability
            <select data-ef="wrapSaveAbility">
              {{#each abilities as |ab|}}
              <option value="{{ab.[0]}}" {{#if (eq ../s.wrapSaveAbility ab.[0])}}selected{{/if}}>{{ab.[1]}}</option>
              {{/each}}
            </select>
          </label>
          <label data-tooltip="A number (e.g. 13). Leave blank to use the creature's spell save DC.">DC
            <input type="text" data-ef="wrapSaveDC" value="{{s.wrapSaveDC}}" class="fc-num" placeholder="spell">
          </label>
          <label id="saveOnSuccessBox" data-tooltip="What a successful save does to the damage below. Effects never apply on a success.">On success
            <select data-ef="saveOnSuccess">
              <option value="half" {{#if (eq s.saveOnSuccess "half")}}selected{{/if}}>Half damage</option>
              <option value="none" {{#if (eq s.saveOnSuccess "none")}}selected{{/if}}>No damage</option>
            </select>
          </label>
        </div>
      </fieldset>
      <fieldset>
        <legend id="saveDamageLegend" data-tooltip="Damage taken on a failed save.">Damage on failure</legend>
        <div id="saveDamageRows"></div>
        <button type="button" data-add-row="saveDamageRows"><i class="fas fa-plus"></i> Add damage</button>
      </fieldset>
    </section>

    <!-- ── Step: Effects ─────────────────────────────────────────────────── -->
    <section class="fc-step" data-step="effects" data-title="Effects">
      <p class="hint" id="effectsHint"></p>
      <!-- ── Application Mode ──────────────────────────────────────────────── -->
      <fieldset id="appModeFieldset">
        <legend>Application Mode</legend>
        <div class="fc-ctl">
          <label data-tooltip="Always active on whatever carries this effect.">
            <input type="radio" data-ef="appMode" name="appMode" value="passive" {{#if (eq s.appMode "passive")}}checked{{/if}}>
            <strong>Passive</strong> — always active on item holder
          </label>
          <label data-tooltip="Applied only when the item is used.">
            <input type="radio" data-ef="appMode" name="appMode" value="activation" {{#if (eq s.appMode "activation")}}checked{{/if}}>
            <strong>On Activation</strong>
          </label>
        </div>
      </fieldset>
      <div id="applyToRow" class="fc-form" data-tooltip="Who receives the effect when the feature is used.">
        <span class="fc-lbl">Apply to</span>
        <div class="fc-ctl">
          <label><input type="radio" data-ef="activationTarget" name="activationTarget" value="wearer" {{#if (eq s.activationTarget "wearer")}}checked{{/if}}> Wearer / Self</label>
          <label><input type="radio" data-ef="activationTarget" name="activationTarget" value="targets" {{#if (eq s.activationTarget "targets")}}checked{{/if}}> Target(s)</label>
        </div>
      </div>

      <!-- ── Duration / Reroll Logic ───────────────────────────────────────── -->
      <fieldset>
        <legend>Duration</legend>
        <div class="fc-form">
          <span class="fc-lbl">Type</span>
          <div class="fc-ctl">
            <label data-tooltip="Lasts a set number of rounds (0 = until removed).">
              <input type="radio" data-ef="durationType" name="durationType" value="fixed" {{#if (eq s.durationType "fixed")}}checked{{/if}}> Fixed (rounds)
            </label>
            <label data-tooltip="Does something every turn: damage, healing, or a save to end it.">
              <input type="radio" data-ef="durationType" name="durationType" value="overtime" {{#if (eq s.durationType "overtime")}}checked{{/if}}> Reroll / Over Time
            </label>
          </div>

          <label>Rounds</label>
          <div class="fc-ctl">
            <input type="number" data-ef="rounds" value="{{s.rounds}}" min="0" class="fc-num">
            <span class="notes">0 = indefinite</span>
          </div>

          <label>Expires</label>
          <div class="fc-ctl">
            <select data-ef="specialDuration" data-tooltip="Ends at a turn boundary instead of after N rounds. Needs the Times-Up module.">
              {{#each specialDurations as |sd|}}
              <option value="{{sd.id}}" {{#if (eq ../s.specialDuration sd.id)}}selected{{/if}}>{{sd.label}}</option>
              {{/each}}
            </select>
            <span class="notes">Needs the Times-Up module to expire.</span>
          </div>
        </div>

        <!-- OverTime sub-section (shown by JS) -->
        <div id="otSection" class="fc-form fc-sep" style="display:none;">
          <label>Trigger</label>
          <div class="fc-ctl">
            <select data-ef="otTrigger" data-tooltip="When the per-turn effect fires.">
              <option value="end" {{#if (eq s.otTrigger "end")}}selected{{/if}}>End of Turn</option>
              <option value="start" {{#if (eq s.otTrigger "start")}}selected{{/if}}>Start of Turn</option>
            </select>
            <label class="fc-lbl">of</label>
            <select data-ef="otWhose" data-tooltip="Whose turn triggers it: the affected creature's, or the one who applied it.">
              <option value="target" {{#if (eq s.otWhose "target")}}selected{{/if}}>Target's turn</option>
              <option value="source" {{#if (eq s.otWhose "source")}}selected{{/if}}>Source's turn</option>
            </select>
          </div>

          <label>Roll</label>
          <div class="fc-ctl">
            <input type="text" data-ef="otDamage" data-tooltip="Rolled each turn, e.g. 1d6. Leave blank for a save-only effect." placeholder="e.g. 1d6, @con.mod — blank = none" value="{{s.otDamage}}">
            <span id="otRollTypeSection" class="fc-inline" style="display:none;">
              <label><input type="radio" data-ef="otRollType" name="otRollType" value="damage" {{#if (eq s.otRollType "damage")}}checked{{/if}}> Damage</label>
              <label><input type="radio" data-ef="otRollType" name="otRollType" value="healing" {{#if (eq s.otRollType "healing")}}checked{{/if}}> Healing</label>
            </span>
            <select id="otDamageTypeSection" data-ef="otDamageType" data-tooltip="Damage type" style="display:none;">
              {{#each damageTypes as |dt|}}
              <option value="{{dt}}" {{#if (eq ../s.otDamageType dt)}}selected{{/if}}>{{dt}}</option>
              {{/each}}
            </select>
          </div>

          <span class="fc-lbl">Save</span>
          <div class="fc-ctl">
            <label data-tooltip="The target saves each turn; enough successes end the effect.">
              <input type="checkbox" data-ef="otSave" {{#if s.otSave}}checked{{/if}}> Saving throw each turn
            </label>
          </div>

          <div id="otSaveSection" class="fc-form fc-full fc-sub" style="display:none;">
            <label>Ability</label>
            <div class="fc-ctl">
              <select data-ef="otSaveAbility" data-tooltip="Prefilled from the Saving Throw step.">
                {{#each abilities as |ab|}}
                <option value="{{ab.[0]}}" {{#if (eq ../s.otSaveAbility ab.[0])}}selected{{/if}}>{{ab.[1]}}</option>
                {{/each}}
              </select>
              <label class="fc-lbl">DC</label>
              <input type="number" data-ef="otSaveDC" value="{{s.otSaveDC}}" min="5" max="30" class="fc-num" data-tooltip="Prefilled from the Saving Throw step.">
            </div>

            <label>On save</label>
            <div class="fc-ctl">
              <select data-ef="otOnSave">
                <option value="nodamage"   {{#if (eq s.otOnSave "nodamage")}}selected{{/if}}>No Damage</option>
                <option value="halfdamage" {{#if (eq s.otOnSave "halfdamage")}}selected{{/if}}>Half Damage</option>
                <option value="fulldamage" {{#if (eq s.otOnSave "fulldamage")}}selected{{/if}}>Full Damage</option>
              </select>
            </div>

            <label>Remove after</label>
            <div class="fc-ctl">
              <input type="number" data-ef="otSuccesses" data-tooltip="Number of successful saves needed to end it." value="{{s.otSuccesses}}" min="1" class="fc-num">
              <span>successful save(s)</span>
            </div>
          </div>
        </div>
      </fieldset>

      <!-- ── Conditions ────────────────────────────────────────────────────── -->
      <fieldset>
        <legend data-tooltip="Standard conditions applied to the target while the effect lasts.">Conditions Applied</legend>
        <div style="display:flex; flex-wrap:wrap; gap:4px 10px;">
          {{#each conditions as |cond|}}
          <label style="display:inline-flex; align-items:center; gap:4px; font-size:0.85em; cursor:pointer; text-transform:capitalize;">
            <input type="checkbox" data-status="{{cond}}"
                   {{#if (lookup ../statusMap cond)}}checked{{/if}}>
            {{cond}}
          </label>
          {{/each}}
        </div>
      </fieldset>

      <!-- ── Roll Modifiers ────────────────────────────────────────────────── -->
      <fieldset>
        <legend data-tooltip="Advantage/disadvantage on rolls. 'Grants' = rolls made AGAINST this creature.">Advantage / Disadvantage</legend>
        <div id="advRowsContainer" style="margin-bottom:6px;"></div>
        <button type="button" id="addAdvRow" style="font-size:0.85em; padding:2px 8px;">
          <i class="fas fa-plus"></i> Add Modifier
        </button>
      </fieldset>

      <!-- ── Stat Modifiers ──────────────────────────────────────────────── -->
      <fieldset>
        <legend>Stat Modifiers</legend>
        <div class="fc-form" style="margin-bottom:8px;">
          <label>AC bonus</label>
          <div class="fc-ctl">
            <input type="number" data-ef="acBonus" data-tooltip="Added to AC. Negative for a penalty." value="{{s.acBonus}}" class="fc-num" placeholder="0">
            <span class="notes">positive = bonus, negative = penalty</span>
          </div>
        </div>
        <label class="fc-lbl" style="display:block; margin-bottom:4px;" data-tooltip="Added to ability scores while active.">Ability score modifiers</label>
        <div id="abilityRowsContainer" style="margin-bottom:6px;"></div>
        <button type="button" id="addAbilityRow" style="font-size:0.85em; padding:2px 8px;">
          <i class="fas fa-plus"></i> Add Ability Modifier
        </button>
      </fieldset>

      <!-- ── Stacking ────────────────────────────────────────────────────── -->
      <fieldset>
        <legend>Effect Stacking <span class="notes" style="font-size:0.82em; font-weight:normal;">(DAE)</span></legend>
        <div class="fc-ctl">
          <select data-ef="stackable" data-tooltip="Whether applying it again adds a second copy or replaces the first." style="max-width:14rem;">
            <option value="none" {{#if (eq s.stackable "none")}}selected{{/if}}>None (default — replaces)</option>
            <option value="count" {{#if (eq s.stackable "count")}}selected{{/if}}>Count Stacks</option>
            <option value="multi" {{#if (eq s.stackable "multi")}}selected{{/if}}>Full Stack (Multi)</option>
          </select>
          <span class="notes">Controls whether multiple copies of this effect stack on a target.</span>
        </div>
      </fieldset>

    </section>

    <!-- ── Step: Review ──────────────────────────────────────────────────── -->
    <section class="fc-step" data-step="review" data-title="Review">
      <fieldset>
        <legend>Summary</legend>
        <p id="fcSummary" class="fc-summary"></p>
      </fieldset>
      <details>
        <summary style="cursor:pointer; font-size:0.85em; color:var(--color-text-light-5);">🔧 Raw preview</summary>
        <pre id="efRawPreview" class="fc-raw"></pre>
      </details>
    </section>

    </div>
  </div>

  <footer class="form-footer">
    <span class="fc-keys"></span>
    <button type="button" data-action="createEffect" style="padding:6px 14px; font-size:1rem; font-weight:bold;">
      <i class="fas fa-sparkles"></i> <span id="fcCreateLabel">Create</span>
    </button>
  </footer>
</form>
